            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns stock register history for a given stock order by date DESC.\nIf `from` and `to` are not provided, defaults to last 30 days.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "stock-registers"
                ],
                "summary": "Get stock registers by date range",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Esquema JWT. Usar:'Bearer {token}'",
                        "name": "authorization",
                        "in": "header",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Stock ID",
                        "name": "stockID",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "example": "2025-01-01T00:00:00Z",
                        "description": "From date (RFC3339)",
                        "name": "from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "2025-02-01T00:00:00Z",
                        "description": "To date (RFC3339)",
                        "name": "to",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.StockRegisterView"
                            }
                        }
